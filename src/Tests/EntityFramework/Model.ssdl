<?xml version="1.0" encoding="utf-8"?>
<Schema Namespace="Store" Alias="Self" Provider="System.Data.SqlClient" ProviderManifestToken="2008" xmlns="http://schemas.microsoft.com/ado/2009/11/edm/ssdl">
    <EntityContainer Name="StoreContainer">
      <EntitySet Name="Company" EntityType="Store.Company" store:Type="Tables" Schema="dbo" xmlns:store="http://schemas.microsoft.com/ado/2007/12/edm/EntityStoreSchemaGenerator" />
      <EntitySet Name="Employee" EntityType="Store.Employee" store:Type="Tables" Schema="dbo" xmlns:store="http://schemas.microsoft.com/ado/2007/12/edm/EntityStoreSchemaGenerator" />
      <EntitySet Name="Events" EntityType="Store.Events" store:Type="Tables" Schema="dbo" xmlns:store="http://schemas.microsoft.com/ado/2007/12/edm/EntityStoreSchemaGenerator" />
      <EntitySet Name="Job" EntityType="Store.Job" store:Type="Tables" Schema="dbo" xmlns:store="http://schemas.microsoft.com/ado/2007/12/edm/EntityStoreSchemaGenerator" />
      <EntitySet Name="sysdiagrams" EntityType="Store.sysdiagrams" store:Type="Tables" Schema="dbo" xmlns:store="http://schemas.microsoft.com/ado/2007/12/edm/EntityStoreSchemaGenerator" />
      <AssociationSet Name="FK_Boss" Association="Store.FK_Boss">
        <End Role="Employee" EntitySet="Employee" />
        <End Role="Employee1" EntitySet="Employee" />
      </AssociationSet>
      <AssociationSet Name="FK_Employee_Company" Association="Store.FK_Employee_Company">
        <End Role="Company" EntitySet="Company" />
        <End Role="Employee" EntitySet="Employee" />
      </AssociationSet>
      <AssociationSet Name="FK_Events_Employee" Association="Store.FK_Events_Employee">
        <End Role="Employee" EntitySet="Employee" />
        <End Role="Events" EntitySet="Events" />
      </AssociationSet>
      <AssociationSet Name="FK_Job_Employee" Association="Store.FK_Job_Employee">
        <End Role="Employee" EntitySet="Employee" />
        <End Role="Job" EntitySet="Job" />
      </AssociationSet>
    </EntityContainer>
    <EntityType Name="Company">
      <Key>
        <PropertyRef Name="Id" />
      </Key>
      <Property Name="Id" Type="int" Nullable="false" StoreGeneratedPattern="Identity" />
      <Property Name="Name" Type="varchar" MaxLength="50" />
      <Property Name="Website" Type="varchar" MaxLength="50" />
    </EntityType>
    <EntityType Name="Employee">
      <Key>
        <PropertyRef Name="Id" />
      </Key>
      <Property Name="Id" Type="int" Nullable="false" StoreGeneratedPattern="Identity" />
      <Property Name="Name" Type="varchar" MaxLength="50" />
      <Property Name="Boss" Type="int" />
      <Property Name="Company" Type="int" />
    </EntityType>
    <EntityType Name="Events">
      <Key>
        <PropertyRef Name="Id" />
      </Key>
      <Property Name="Id" Type="int" Nullable="false" StoreGeneratedPattern="Identity" />
      <Property Name="Employee" Type="int" />
      <Property Name="EventTitle" Type="varchar" MaxLength="50" />
      <Property Name="Details" Type="varchar" MaxLength="50" />
    </EntityType>
    <EntityType Name="Job">
      <Key>
        <PropertyRef Name="Id" />
      </Key>
      <Property Name="Id" Type="int" Nullable="false" StoreGeneratedPattern="Identity" />
      <Property Name="Title" Type="varchar" MaxLength="50" />
      <Property Name="Employee" Type="int" Nullable="false" />
      <Property Name="Status" Type="varchar" MaxLength="50" />
    </EntityType>
    <EntityType Name="sysdiagrams">
      <Key>
        <PropertyRef Name="diagram_id" />
      </Key>
      <Property Name="name" Type="nvarchar" Nullable="false" MaxLength="128" />
      <Property Name="principal_id" Type="int" Nullable="false" />
      <Property Name="diagram_id" Type="int" Nullable="false" StoreGeneratedPattern="Identity" />
      <Property Name="version" Type="int" />
      <Property Name="definition" Type="varbinary(max)" />
    </EntityType>
    <Association Name="FK_Boss">
      <End Role="Employee" Type="Store.Employee" Multiplicity="0..1" />
      <End Role="Employee1" Type="Store.Employee" Multiplicity="*" />
      <ReferentialConstraint>
        <Principal Role="Employee">
          <PropertyRef Name="Id" />
        </Principal>
        <Dependent Role="Employee1">
          <PropertyRef Name="Boss" />
        </Dependent>
      </ReferentialConstraint>
    </Association>
    <Association Name="FK_Employee_Company">
      <End Role="Company" Type="Store.Company" Multiplicity="0..1" />
      <End Role="Employee" Type="Store.Employee" Multiplicity="*" />
      <ReferentialConstraint>
        <Principal Role="Company">
          <PropertyRef Name="Id" />
        </Principal>
        <Dependent Role="Employee">
          <PropertyRef Name="Company" />
        </Dependent>
      </ReferentialConstraint>
    </Association>
    <Association Name="FK_Events_Employee">
      <End Role="Employee" Type="Store.Employee" Multiplicity="0..1" />
      <End Role="Events" Type="Store.Events" Multiplicity="*" />
      <ReferentialConstraint>
        <Principal Role="Employee">
          <PropertyRef Name="Id" />
        </Principal>
        <Dependent Role="Events">
          <PropertyRef Name="Employee" />
        </Dependent>
      </ReferentialConstraint>
    </Association>
    <Association Name="FK_Job_Employee">
      <End Role="Employee" Type="Store.Employee" Multiplicity="1" />
      <End Role="Job" Type="Store.Job" Multiplicity="*" />
      <ReferentialConstraint>
        <Principal Role="Employee">
          <PropertyRef Name="Id" />
        </Principal>
        <Dependent Role="Job">
          <PropertyRef Name="Employee" />
        </Dependent>
      </ReferentialConstraint>
    </Association>
  </Schema>
